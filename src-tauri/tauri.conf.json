{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "업체별 업무 일정",
  "mainBinaryName": "work-calendar-helper",
  "version": "0.2.0",
  "identifier": "kr.go.goseong.work-calendar-helper",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "업체별 업무 일정",
        "url": "index.html",
        "width": 1380,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650,
        "center": true,
        "resizable": true
      },
      {
        "label": "helper",
        "title": "D-day 도우미",
        "url": "helper.html",
        "width": 330,
        "height": 430,
        "minWidth": 280,
        "minHeight": 280,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "_comment": "style-src 의 unsafe-inline 은 app.js 가 만들어내는 인라인 style= 속성 때문이다. 폰트·아이콘·스크립트는 전부 번들되어 있어 'self' 로 충분하다.",
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "capabilities": [
        "default",
        "main-files"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "업체별 일정과 D-day를 한눈에 관리"
  }
}