{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "업체별 업무 일정",
  "mainBinaryName": "work-calendar-helper",
  "version": "0.6.0",
  "identifier": "kr.go.goseong.work-calendar-helper",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "cal",
        "title": "달력 시트 (cal)",
        "url": "index.html?w=cal",
        "width": 980,
        "height": 700,
        "minWidth": 620,
        "minHeight": 460,
        "x": 80,
        "y": 60,
        "visible": false,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "mini",
        "title": "미니 대시보드 (mini)",
        "url": "index.html?w=mini",
        "width": 362,
        "height": 640,
        "minWidth": 300,
        "minHeight": 380,
        "x": 1080,
        "y": 60,
        "visible": false,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "status",
        "title": "현황 (status)",
        "url": "index.html?w=status",
        "width": 362,
        "height": 400,
        "minWidth": 300,
        "minHeight": 240,
        "x": 1080,
        "y": 716,
        "visible": false,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "capabilities": [
        "default",
        "main-files"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "업체별 일정과 D-day를 한눈에 관리",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Korean"
        ]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}